# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Port the API listens on (the Vite dev server forwards /api here)
PORT=5000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=content-dabase

# Secret used to sign login tokens. Use a long random string and keep it private.
JWT_SECRET=change-me-to-a-long-random-string