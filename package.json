{
  "name": "avora",
  "version": "1.0.0",
  "private": true,
  "description": "Avora - a Pinterest-style content sharing app (Vue 3 frontend, Express + MySQL backend).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "run-p dev:backend dev:frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "server": "npm run start -w backend",
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "type-check": "npm run type-check -w frontend"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
