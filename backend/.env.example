# Copy this file to ".env" and fill in your own values. Never commit ".env".

# development | production. Production refuses to start with a weak JWT_SECRET and skips demo data.
NODE_ENV=development

# Port the API listens on (the Vite dev server forwards /api here)
PORT=5000

# Website origin(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse proxies in front of the API (0 if none). Needed for correct rate limiting behind nginx etc.
TRUST_PROXY=0

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=content-dabase

# Secret used to sign login tokens: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Create demo users and pins on an empty database (default: true in development, false in production)
# SEED_DEMO_DATA=true
